{
  "buildCommand": "sh outils/assembler_vercel.sh",
  "outputDirectory": "dist",
  "framework": null,
  "crons": [{ "path": "/api/cron/purge", "schedule": "17 3 * * *" }, { "path": "/api/cron/rappel", "schedule": "0 15 * * *" }],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/quiz/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
