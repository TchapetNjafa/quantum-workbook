// Calculateur de probabilités
function initializeProbabilityCalculator() {
  const calculateBtn = document.getElementById('calculate-probs');
  if (!calculateBtn) return;

  calculateBtn.addEventListener('click', function() {
    const alphaReal = parseFloat(document.getElementById('alpha-real').value) || 0;
    const alphaImag = parseFloat(document.getElementById('alpha-imag').value) || 0;
    const betaReal = parseFloat(document.getElementById('beta-real').value) || 0;
    const betaImag = parseFloat(document.getElementById('beta-imag').value) || 0;

    // Calculer les modules
    const alphaModSq = alphaReal * alphaReal + alphaImag * alphaImag;
    const betaModSq = betaReal * betaReal + betaImag * betaImag;

    // Normalisation
    const norm = Math.sqrt(alphaModSq + betaModSq);

    if (norm === 0) {
      alert('État nul ! Veuillez entrer des amplitudes non nulles.');
      return;
    }

    const alphaRealNorm = alphaReal / norm;
    const alphaImagNorm = alphaImag / norm;
    const betaRealNorm = betaReal / norm;
    const betaImagNorm = betaImag / norm;

    // Probabilités
    const prob0 = (alphaRealNorm * alphaRealNorm + alphaImagNorm * alphaImagNorm);
    const prob1 = (betaRealNorm * betaRealNorm + betaImagNorm * betaImagNorm);

    // Formatage des nombres complexes
    function formatComplex(real, imag) {
      if (Math.abs(imag) < 0.001) return real.toFixed(3);
      if (Math.abs(real) < 0.001) return `${imag.toFixed(3)}i`;
      const sign = imag >= 0 ? '+' : '';
      return `${real.toFixed(3)} ${sign} ${imag.toFixed(3)}i`;
    }

    // Affichage SIMPLIFIÉ - pas de MathJax
    const alphaStr = formatComplex(alphaRealNorm, alphaImagNorm);
    const betaStr = formatComplex(betaRealNorm, betaImagNorm);

    const normalizedStateEl = document.getElementById('normalized-state');
    if (normalizedStateEl) {
      normalizedStateEl.textContent = `État: (${alphaStr})|0⟩ + (${betaStr})|1⟩`;
    }

    const prob0El = document.getElementById('calc-prob-0');
    const prob1El = document.getElementById('calc-prob-1');
    const probSumEl = document.getElementById('prob-sum');

    if (prob0El) prob0El.textContent = prob0.toFixed(3);
    if (prob1El) prob1El.textContent = prob1.toFixed(3);
    if (probSumEl) {
      probSumEl.textContent = (prob0 + prob1).toFixed(3);

      // Vérification
      if (Math.abs(prob0 + prob1 - 1) < 0.001) {
        probSumEl.style.color = '#10b981';
      } else {
        probSumEl.style.color = '#ef4444';
      }
    }
  });
}
</script>