          <label for="option-2b">$$\frac{1}{2}$$</label>
        </div>
        <div class="option-item" data-option-id="c" data-correct="false" data-explanation="Non, ceci est l'amplitude, pas la probabilité.">
          <input type="radio" name="exercise-ch1-ex2" class="option-radio" id="option-2c">
